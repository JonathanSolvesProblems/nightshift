<mxfile host="app.diagrams.net" type="device">
  <diagram id="nightshift-architecture" name="Nightshift">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Nightshift" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2422;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="400" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One demand letter in. A claim chart out. Nothing guided in between." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4C5451;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="620" height="20" as="geometry" />
        </mxCell>

        <mxCell id="lane1" value="Cloud Run" style="swimlane;horizontal=1;startSize=40;fillColor=#FAFBF8;strokeColor=#B0B5AC;strokeWidth=1;fontSize=14;fontStyle=1;fontColor=#4C5451;fontFamily=Helvetica;html=1;rounded=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="380" height="880" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="BigQuery" style="swimlane;horizontal=1;startSize=40;fillColor=#FAFBF8;strokeColor=#B0B5AC;strokeWidth=1;fontSize=14;fontStyle=1;fontColor=#4C5451;fontFamily=Helvetica;html=1;rounded=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="450" y="90" width="380" height="880" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="Vertex AI and Firestore" style="swimlane;horizontal=1;startSize=40;fillColor=#FAFBF8;strokeColor=#B0B5AC;strokeWidth=1;fontSize=14;fontStyle=1;fontColor=#4C5451;fontFamily=Helvetica;html=1;rounded=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="90" width="400" height="880" as="geometry" />
        </mxCell>

        <mxCell id="letter" value="&lt;b&gt;Demand letter&lt;/b&gt;&lt;br&gt;PDF or a photo of the page" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2422;strokeWidth=1.5;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="148" width="300" height="56" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;1 &#160;Read the letter&lt;/b&gt;&lt;br&gt;Gemini 3.5 Flash decides whether it is an&lt;br&gt;assertion at all, which patent, and who sent it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF4E4;strokeColor=#4F7318;strokeWidth=2;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="890" y="140" width="340" height="72" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;2 &#160;Split claim 1&lt;/b&gt;&lt;br&gt;Gemini 3.5 Flash returns 7 limitations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF4E4;strokeColor=#4F7318;strokeWidth=2;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="890" y="248" width="340" height="60" as="geometry" />
        </mxCell>

        <mxCell id="orch" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;service &quot;nightshift&quot;, one request&lt;br&gt;Refuses before it spends: no claim text,&lt;br&gt;not in corpus, not a patent number" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2422;strokeWidth=1.5;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="248" width="300" height="88" as="geometry" />
        </mxCell>

        <mxCell id="corpus" value="&lt;b&gt;Corpus, materialized once&lt;/b&gt;&lt;br&gt;171,695 US patents in CPC G06Q&lt;br&gt;clustered on patent_id&lt;br&gt;filing and priority dates, 768d embeddings" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2422;strokeWidth=1.5;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;3 &#160;Priority-date gate&lt;/b&gt;&lt;br&gt;Anything filed after the target&apos;s priority date&lt;br&gt;cannot be prior art against it&lt;br&gt;&lt;br&gt;171,694 &#8594; 126,787 dropped &#8594; &lt;b&gt;44,907 eligible&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2422;strokeWidth=1.5;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="480" y="290" width="320" height="96" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;4 &#160;Rank and materialize&lt;/b&gt;&lt;br&gt;Cosine distance on gemini-embedding-001&lt;br&gt;Top 2,000 written to run_&amp;lt;id&amp;gt;, clustered&lt;br&gt;&lt;br&gt;Ranked once here, not once per task" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2422;strokeWidth=1.5;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="480" y="420" width="320" height="96" as="geometry" />
        </mxCell>

        <mxCell id="job" value="&lt;b&gt;5 &#160;Cloud Run Job &quot;nightshift-worker&quot;&lt;/b&gt;&lt;br&gt;10 parallel tasks, launched with RUN_ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2422;strokeWidth=2;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="420" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="t0" value="task 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F4F0;strokeColor=#4C5451;strokeWidth=1;fontSize=11;fontColor=#1F2422;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="86" y="470" width="80" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="task 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F4F0;strokeColor=#4C5451;strokeWidth=1;fontSize=11;fontColor=#1F2422;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="176" y="470" width="80" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="task 9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F4F0;strokeColor=#4C5451;strokeWidth=1;fontSize=11;fontColor=#1F2422;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="266" y="470" width="80" height="34" as="geometry" />
        </mxCell>
        <mxCell id="shardnote" value="Each task takes its own slice:&lt;br&gt;&lt;b&gt;MOD(rank, TASK_COUNT) = TASK_INDEX&lt;/b&gt;&lt;br&gt;No task talks to another." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4C5451;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="86" y="512" width="280" height="54" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="&lt;b&gt;6 &#160;Read every candidate&lt;/b&gt;&lt;br&gt;Gemini 3.5 Flash, one call per patent,&lt;br&gt;scored against all 7 limitations&lt;br&gt;&lt;br&gt;2,000 calls per run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF4E4;strokeColor=#4F7318;strokeWidth=2;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="890" y="420" width="340" height="96" as="geometry" />
        </mxCell>

        <mxCell id="fs" value="&lt;b&gt;7 &#160;Firestore, database &quot;nightshift&quot;&lt;/b&gt;&lt;br&gt;runs / shards / findings&lt;br&gt;&lt;br&gt;All state lives here, never in memory.&lt;br&gt;Whichever task finishes last sees every&lt;br&gt;shard is done and closes the run." style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2422;strokeWidth=1.5;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="890" y="560" width="340" height="140" as="geometry" />
        </mxCell>

        <mxCell id="web" value="&lt;b&gt;8 &#160;Core log&lt;/b&gt;&lt;br&gt;Browser polls the service while the job runs,&lt;br&gt;and stops polling when the run is done.&lt;br&gt;&lt;br&gt;Close the tab and the work continues." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2422;strokeWidth=1.5;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="640" width="300" height="96" as="geometry" />
        </mxCell>

        <mxCell id="chart" value="&lt;b&gt;9 &#160;Claim chart&lt;/b&gt;&lt;br&gt;Drawn on demand for one reference and&lt;br&gt;cached. Every limitation mapped, with the&lt;br&gt;passage quoted verbatim from the reference.&lt;br&gt;&lt;br&gt;&lt;b&gt;The deliverable.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F7318;strokeWidth=2.5;fontSize=12;fontColor=#1F2422;fontFamily=Helvetica;align=left;spacingLeft=12;verticalAlign=middle;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="776" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="secnote" value="&lt;b&gt;Credentials&lt;/b&gt;&#160; No key material in code or image. The service and&lt;br&gt;the job run as a service account and reach Vertex AI, BigQuery and&lt;br&gt;Firestore through Application Default Credentials. The one action that&lt;br&gt;spends money is gated by a token and capped per day." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4C5451;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="480" y="560" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="costnote" value="&lt;b&gt;Why materialize&lt;/b&gt;&#160; One description lookup against the public&lt;br&gt;patent tables scans 1,052 GB. Those tables are not clustered on&lt;br&gt;patent id, so a WHERE filter still reads the whole column. After&lt;br&gt;materializing and clustering, a target fetch is 0.20 GB. About 200x." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4C5451;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="480" y="660" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gradenote" value="&lt;b&gt;How accuracy is graded&lt;/b&gt;&#160; Not by me. The USPTO publishes which&lt;br&gt;references an examiner applied in a rejection. The agent searches&lt;br&gt;blind, with the file history hidden, and is scored on whether it&lt;br&gt;independently re-finds what the examiner used." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4C5451;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="480" y="760" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2422;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="letter" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2422;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=0;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="s2" target="orch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2422;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="orch" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2422;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="corpus" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2422;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2422;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=0;exitY=0.5;entryX=1;entryY=0.2;" edge="1" parent="1" source="s5" target="job">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2422;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="job" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2422;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s6" target="fs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2422;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="fs" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4F7318;strokeWidth=2.5;endArrow=block;endFill=1;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="web" target="chart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="reads its shard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C5451;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;exitX=1;exitY=0.8;entryX=0;entryY=0.85;fontSize=11;fontColor=#4C5451;fontFamily=Helvetica;" edge="1" parent="1" source="job" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
