# Credentials. Never commit these.
.secrets/
*.json.key
service-account*.json
application_default_credentials.json
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Working output
out/
runs/
*.log

# Demo footage. Local only, never committed.
#
# Screen recordings run to hundreds of megabytes and the finished film lives on
# YouTube, so nothing here belongs in the repository. The extensions are listed
# as well as the folder, because the expensive mistake is a stray capture saved
# somewhere else and committed by a `git add -A` at 2am on deadline night.
broll/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.aiff
*.m4a

# Submission working files and preview images. These are Devpost form content
# and screenshots, not part of the project a judge clones.
_submission/
preview/
